# ===========================================
# 生成文件 — 标书导出（138MB+，运行时生成）
# ===========================================
bid-agent/data/exports/*
!bid-agent/data/exports/.gitkeep

# ===========================================
# 用户上传文件（运行时产生）
# ===========================================
bid-agent/data/uploads/*
!bid-agent/data/uploads/.gitkeep

# ===========================================
# FAISS 索引（运行时生成）
# ===========================================
bid-agent/data/faiss_index/*
!bid-agent/data/faiss_index/.gitkeep

